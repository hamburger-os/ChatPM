{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "noEmit": false,
    "incremental": false,
    "rewriteRelativeImportExtensions": true,
    "jsx": "react-jsx"
  },
  "include": [
    "apps/api/src/**/*.ts",
    "apps/worker/src/**/*.ts",
    "packages/core/src/**/*.ts"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/*.integration.ts",
    "node_modules",
    "**/.next/**"
  ]
}
