[Unit]
Description=ChatPM API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=chatpm
Group=chatpm
WorkingDirectory=/opt/chatpm
Environment=NODE_ENV=production
EnvironmentFile=/opt/chatpm/.env
ExecStart=/usr/bin/node /opt/chatpm/dist/apps/api/src/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
