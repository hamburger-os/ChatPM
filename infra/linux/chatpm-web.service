[Unit]
Description=ChatPM web frontend
After=network-online.target chatpm-api.service
Wants=network-online.target

[Service]
Type=simple
User=chatpm
Group=chatpm
WorkingDirectory=/opt/chatpm
Environment=NODE_ENV=production
EnvironmentFile=/opt/chatpm/.env
ExecStart=/usr/bin/node /opt/chatpm/node_modules/next/dist/bin/next start apps/web -p 3000 -H 127.0.0.1
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/chatpm/apps/web/.next

[Install]
WantedBy=multi-user.target
