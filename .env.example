NODE_ENV=development
# Use a dedicated PostgreSQL database (installed natively or run via Compose).
DATABASE_URL=postgres://chatpm:chatpm@127.0.0.1:5432/chatpm
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
MODEL_ENCRYPTION_KEY=replace-with-a-separate-long-random-model-key
WEB_ORIGIN=http://localhost:3000
API_HOST=127.0.0.1
API_PORT=3001
API_INTERNAL_URL=http://127.0.0.1:3001
DB_POOL_MAX=10
# In production registration defaults to bootstrap (first user only); to allow
# additional self-signups deliberately choose REGISTRATION_MODE=open.
# REGISTRATION_MODE=bootstrap
# Generated by setup:local/deploy:docker, not published to the browser.
# BOOTSTRAP_TOKEN=<64 random hexadecimal characters>
# External AI is disabled until the system administrator creates a default model.
AI_DAILY_REQUEST_LIMIT=50
