{
  "name": "chatpm",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0 <25"
  },
  "scripts": {
    "dev": "node tools/ops/run.mjs dev",
    "dev:api": "tsx watch apps/api/src/server.ts",
    "dev:worker": "tsx watch apps/worker/src/worker.ts",
    "dev:web": "next dev apps/web -p 3000",
    "db:migrate": "tsx packages/core/src/migrate.ts",
    "test": "tsx --test packages/core/test/*.test.ts",
    "test:architecture": "node --test tools/test/architecture-boundaries.test.mjs",
    "test:ai-evals": "node --import tsx --test tools/evals/pm-golden.test.mjs",
    "eval:pm:live": "node --import tsx tools/evals/run-pm-golden.mjs",
    "typecheck": "tsc --noEmit",
    "build:web": "next build apps/web",
    "check:docs": "node tools/docs/check-docs.mjs",
    "build:server": "tsc -p tsconfig.server.json && node tools/build/copy-sql.mjs",
    "build": "npm run build:server && npm run build:web",
    "db:migrate:prod": "node dist/packages/core/src/migrate.js",
    "start:api": "node dist/apps/api/src/server.js",
    "start:worker": "node dist/apps/worker/src/worker.js",
    "start:web": "next start apps/web -p 3000 -H 127.0.0.1",
    "start:web:container": "next start apps/web -p 3000 -H 0.0.0.0",
    "check:distribution": "node tools/test/distribution.mjs",
    "start": "node tools/ops/run.mjs prod",
    "stop": "node tools/ops/stop.mjs",
    "deploy:docker": "node tools/ops/deploy.mjs",
    "test:ops": "node --test tools/test/ops.test.mjs",
    "setup:native": "npm ci && npm run build && npm run check:distribution && npm run db:migrate:prod",
    "doctor": "node tools/ops/doctor.mjs",
    "admin:grant": "node tools/ops/grant-admin.mjs",
    "backup": "node tools/ops/backup.mjs",
    "backup:docker": "node tools/ops/backup.mjs --docker",
    "restore": "node tools/ops/restore.mjs",
    "setup:local": "node tools/ops/bootstrap-native.mjs",
    "upgrade:native": "node tools/ops/upgrade.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^11.0.0",
    "fastify": "^5.12.5",
    "jose": "^6.0.0",
    "next": "^16.1.0",
    "pg": "^8.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.2.0",
    "zod": "^3.25.0",
    "@fastify/helmet": "^13.1.2",
    "@fastify/rate-limit": "^11.2.1",
    "dotenv": "^16.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
