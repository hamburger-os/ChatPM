{
  "name": "chatpm",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0 <25"
  },
  "scripts": {
    "dev:api": "tsx watch apps/api/src/server.ts",
    "dev:worker": "tsx watch apps/worker/src/worker.ts",
    "dev:web": "next dev apps/web -p 3000",
    "db:migrate": "tsx packages/core/src/migrate.ts",
    "test": "tsx --test packages/core/test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build:web": "next build apps/web",
    "check:docs": "node tools/docs/check-docs.mjs",
    "build:server": "tsc -p tsconfig.server.json && node tools/build/copy-sql.mjs",
    "build": "npm run build:server && npm run build:web",
    "db:migrate:prod": "node dist/packages/core/src/migrate.js",
    "start:api": "node dist/apps/api/src/server.js",
    "start:worker": "node dist/apps/worker/src/worker.js",
    "start:web": "next start apps/web -p 3000 -H 0.0.0.0",
    "check:distribution": "node tools/test/distribution.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^11.0.0",
    "fastify": "^5.12.5",
    "jose": "^6.0.0",
    "next": "^16.1.0",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.5",
    "@fastify/helmet": "^13.1.2",
    "@fastify/rate-limit": "^11.2.1",
    "dotenv": "^16.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
